<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>THE ART OF CRAFT — AMÉLIE FAURENT</title>

  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@100;200;300;400&display=swap"
    rel="stylesheet"
  />

  <style>
    :root {
      --bg: #ffffff;
      --txt: #000000;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--txt);
      font-family: 'Inter', sans-serif;
      font-weight: 200;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }

    nav {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      padding: 24px 40px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 1000;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(10px);
      font-size: 11px;
      text-transform: lowercase;
      letter-spacing: 0.12em;
    }

    .nav-left,
    .nav-right {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .nav-link {
      text-decoration: none;
      color: var(--txt);
      transition: opacity 0.3s ease;
    }

    .nav-link:hover {
      opacity: 0.4;
    }

</html>
